{
  "name": "dsh-visual-safety-control",
  "version": "0.4.0",
  "description": "Windows desktop-control plugin for DeepSeek Harness: screenshot, local OCR and UI Automation with a content policy (dangerous labels / sensitive windows / secrets) and action verification (hit-test, expect, verifyText). Fork of qingying012/dsh-desktop-control (MIT).",
  "author": "XiaYuehua <2814895010@qq.com> (https://github.com/Kxiaoguai3)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kxiaoguai3/dsh-visual-safety-control.git"
  },
  "homepage": "https://github.com/Kxiaoguai3/dsh-visual-safety-control#readme",
  "bugs": {
    "url": "https://github.com/Kxiaoguai3/dsh-visual-safety-control/issues"
  },
  "type": "module",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh",
    "assets",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "OPERATING-RULES.md",
    "TESTING.md",
    "PUBLISH.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "selftest": "node scripts/selftest.mjs"
  },
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop",
    "screenshot",
    "ocr",
    "uia",
    "automation",
    "windows",
    "policy",
    "safety",
    "verification"
  ]
}
